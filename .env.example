# Google Gemini API key (optional — falls back to deterministic civic triage when unset)
GEMINI_API_KEY=

# Admin dashboard passcode (required in production; defaults to civic-admin-2026 in local dev)
ADMIN_PASSCODE=civic-admin-2026

# HMAC signing secret for HttpOnly admin session cookies (minimum 32 chars in production)
SESSION_SECRET=replace-with-a-random-32-plus-char-secret-in-production

# Cloud Run listening port (defaults to 8080)
PORT=8080

# Allowed origin for CORS / same-origin checks in production (optional; inferred from Host if omitted)
PUBLIC_ORIGIN=

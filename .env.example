# Google AI Studio key (free tier works). Without it, triage uses the deterministic rule engine.
GEMINI_API_KEY=
# Optional: comma-separated Gemini models tried in order.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Admin passcode. Required in production; defaults to civic-admin-2026 locally.
ADMIN_PASSCODE=civic-admin-2026
# HMAC secret for admin session cookies. Required in production (32+ characters).
SESSION_SECRET=

# Store issues in Cloud Firestore (uses Application Default Credentials). Memory when unset.
FIRESTORE_ENABLED=false

# Firebase Authentication (Google + guest sign-in). Public web-app values; all four enable sign-in.
# Without them, sign-in is off and reports are anonymous.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Comma-separated Google accounts that may open the admin console with Google sign-in.
ADMIN_EMAILS=
# API requests per client IP per minute.
RATE_LIMIT_PER_MINUTE=60

# Port (Cloud Run sets this automatically).
PORT=8080
# Optional extra origin allowed to make state-changing requests.
PUBLIC_ORIGIN=
